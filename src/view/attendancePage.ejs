<h1 class=" text-3xl font-bold text-center mt-20 mb-5">Những buổi điểm danh đã thực hiện</h1>
<table class="table-auto w-full max-w-7xl mx-auto">
  <thead class="bg-gray-400">
    <tr class="">
      <th>STT</th>
      <th class="p-2">Mã lớp</th>
      <th>Lớp</th>
      <th>Ngày thực hiện</th>
      <th>Ghi chú</th>
      <th>Hành động</th>
    </tr>
  </thead>
  <tbody>
  <% List.forEach((list,index) => {%>
        <tr class="hover:bg-gray-200">
          <td class="text-center p-1.5"><%=index+1%></td>
          <td class="text-center p-1.5"><%=list.class_code%></td>
          <td class="text-center p-1.5"><%=list.class_name%></td>
          <td class="text-center p-1.5"><%=list.session_date%></td>
          <td class="text-center p-1.5"><%=list.note%></td>
          <td class="text-center" onclick="event.stopPropagation()">
          <button class="bg-transparent hover:bg-white font-semibold px-3 border rounded" 
          onclick="window.location.href='/attendance/<%=list.id%>'">Chi tiết  </button>
          </td>
        </tr>
      <%}); %>
  </tbody>
</table>
 <button id="addAAttendance" class="ml-[45%] mt-10 bg-transparent hover:bg-green-500 text-green-700 font-semibold hover:text-white py-2 px-4 border border-green-500 hover:border-transparent rounded">Thêm buổi điểm danh mới</button>


<div id="classesList" class="hidden fixed inset-0 z-50 backdrop-blur-xs justify-center items-center">
    <table class=" table-auto w-[80%] max-w-7xl mx-auto top-[30%] fixed inset-0 ">
      <thead class="bg-gray-400">
        <tr class="">
          <th>STT</th>
          <th class="p-2">Mã lớp</th>
          <th>Tên</th>
          <th>Môn học</th>
          <th>Giáo viên</th>
          <th>Mô tả</th>
        </tr>
      </thead>
      <tbody>
      <% classesList.forEach((classes,index) => {%>
            <tr onclick="window.location.href='/classes/<%=classes.id%>/attendance/create'"
             class="bg-white cursor-pointer">
              <td class="text-center p-1.5"><%=index+1%></td>
              <td class="text-center p-1.5"><%=classes.code%></td>
              <td class="text-center p-1.5"><%=classes.name%></td>
              <td class="text-center p-1.5"><%=classes.subject%></td>
              <td class="text-center p-1.5"><%=classes.teacher_name%></td>
              <td class="text-center p-1.5"><%=classes.description%></td>
            </tr>
          <%}); %>
      </tbody>
    </table>
</div>