<form action="/classes/search" class="max-w-md mx-auto mt-20" method="get">
  <div
    class="relative flex border border-default-medium items-center place-content-around"
  >
    <i class="fa-solid fa-magnifying-glass text-[20px]"></i>
    <input
      type="search"
      name="keyword"
      class="outline-none block w-[90%] p-3 ps-2 bg-neutral-secondary-medium text-heading text-sm rounded-base shadow-xs"
      placeholder="Tìm kiếm trong tất cả các lớp và học viên"
      required
    />
  </div>
</form>
