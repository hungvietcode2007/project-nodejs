<% const averageScoreCal=(class_id)=>{
  const score=[];
  for(const element of scoreData){
    if(element.class_id==class_id){
      score.push(element.score);
    }
  }
  if (score.length===0)return 0;
  const sum=score.reduce((acc, curr) => acc +  Number(curr), 0);
  return (sum/score.length).toFixed(2);
} %>
<%const getScore=(class_id)=>{
  const score=[];
  for(const element of scoreData){
    if(element.class_id==class_id){
      score.push(element);
    }
  }
  return score;
}%>
<%const getAttendance=(class_id)=>{
  const attendance=[];
  for(const element of attendanceData){
    if(element.class_id==class_id){
      attendance.push(element);
    }
  }
  return attendance;
}%>
<h1 class="mt-20 mb-5 text-3xl font-bold text-center">Các lớp học của học viên <%=student_name[0].full_name%></h1>
<table class="table-auto w-full max-w-7xl mx-auto">
  <thead class="bg-gray-400">
    <tr class="">
      <th>STT</th>
      <th class="p-2">Mã lớp</th>
      <th>Tên</th>
      <th>Môn học</th>
      <th>Giáo viên</th>
      <th>Số buổi học</th>
      <th>Điểm TB</th>
      <th>Hành động</th>
    </tr>
  </thead>
  <tbody>
  <% classesList.forEach((classes,index) => {%>
        <tr class="hover:bg-gray-200">
          <td class="text-center p-1.5"><%=index+1%></td>
          <td class="text-center p-1.5"><%=classes.code%></td>
          <td class="text-center p-1.5"><%=classes.name%></td>
          <td class="text-center p-1.5"><%=classes.subject%></td>
          <td class="text-center p-1.5"><%=classes.teacher_name%></td>
          <%const attendance=getAttendance(classes.id)%>
          <td class="text-center p-1.5"><%=attendance.length%>
            <div class="inline-block relative">
            <button class="ml-3 bg-white hover:bg-green-200 hover:cursor-pointer font-semibold px-3 border rounded" onclick="this.nextElementSibling.classList.toggle('hidden')">Chi tiết</button>
            <table class="absolute right-0 hidden w-full z-50 shadow-lg min-w-75">
              <thead class="bg-gray-300">
                <tr>
                  <th>Ngày</th>
                  <th>Đi học</th>
                  <th>Ghi chú</th>
                </tr>
              </thead>
              <tbody>
              <%attendance.forEach((attendance,index)=>{%>
                <tr class="bg-white">
                <td><%=attendance.date%></td>
                <td><%=attendance.status%></td>
                <td><%=attendance.note%></td>
                </tr>
                <%})%>  
              </tbody>
            </table>
            </div>
            </td>
          <td class="text-center p-1.5"><%=averageScoreCal(classes.id)%>
          <div class="inline-block relative">
            <button class="ml-3 bg-white hover:bg-green-200 hover:cursor-pointer font-semibold px-3 border rounded" onclick="this.nextElementSibling.classList.toggle('hidden')">Chi tiết</button>
            <table class="absolute right-0 hidden w-full z-50 shadow-lg min-w-75">
              <thead class="bg-gray-300">
                <tr>
                  <th>Ngày</th>
                  <th>Bài</th>
                  <th>Điểm</th>
                </tr>
              </thead>
              <tbody>
              <%const score=getScore(classes.id);%>
              <%score.forEach((score,index)=>{%>
                <tr class="bg-white">
                <td><%=score.test_date%></td>
                <td><%=score.title%></td>
                <td><%=score.score%></td>
                </tr>
                <%})%>  
              </tbody>
            </table>
            </div>
            </td>
          <td class="text-center" onclick="event.stopPropagation()">
            <form action="/students/<%=student_id%>/delete/<%=classes.id%>" method="post">
                <button onclick="this.nextElementSibling.classList.toggle('hidden')" type="button" class="optionsBtn bg-white hover:bg-red-400 hover:cursor-pointer font-semibold px-3 border rounded" 
                >Rời lớp</button>
                <div tabindex="-1" class="hidden flex bg-gray-900/50 overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
        <div class="relative p-4 w-full max-w-md max-h-full">
                <div class="p-4 md:p-5 text-center bg-white">
                    <svg class="mx-auto mb-4 text-fg-disabled w-12 h-12" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13V8m0 8h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                    <h3 class="mb-6 text-body">Bạn có muốn rời lớp <%=classes.name%> k </h3>
                    <div class="flex items-center space-x-4 justify-center">
                            <button type="submit" class="text-body bg-neutral-secondary-medium box-border border border-default-medium hover:bg-neutral-tertiary-medium hover:text-heading focus:ring-4 focus:ring-neutral-tertiary shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none hover:bg-red-500 hover:text-white">
                            Xóa
                            </button>
                        <button onclick="this.closest('.fixed').classList.toggle('hidden')" type="button" class="text-body bg-neutral-secondary-medium box-border border border-default-medium hover:bg-neutral-tertiary-medium hover:text-heading focus:ring-4 focus:ring-neutral-tertiary shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none hover:bg-gray-500 hover:text-white">Không</button>
                </div>
            </div>
        </div>
    </div>
            </form>
          </div>
          </td>
        </tr>
      <%}); %>
  </tbody>
</table>
 <button class="ml-[45%] mt-10 bg-transparent hover:bg-green-500 text-green-700 font-semibold hover:text-white py-2 px-4 border border-green-500 hover:border-transparent rounded" onclick="window.location.href='/students/<%=student_id%>/add'">Thêm 1 lớp mới</button>
