<h1 class=" mb-5 text-3xl font-bold text-center mt-20">Danh sách điểm danh ngày <%=results2[0].session_date%></h1>
<table class="table-auto w-full max-w-7xl mx-auto">
  <thead class="bg-gray-400">
    <tr class="">
      <th>STT</th>
      <th class="p-2">Mã học viên</th>
      <th>Họ tên</th>
      <th>Ngày sinh</th>
      <th>Trạng thái</th>
      <th>Ghi chú</th>
    </tr>
  </thead>
  <tbody>
  <% List.forEach((list,index) => {%>
        <tr class="hover:bg-gray-200 hover:cursor-pointer">
          <td class="text-center p-1.5"><%=index+1%></td>
          <td class="text-center p-1.5"><%=list.student_code%></td>
          <td class="text-center p-1.5"><%=list.student_name%></td>
          <td class="text-center p-1.5"><%=list.dob%></td>
          <td class="text-center p-1.5"><%=list.status%></td>
          <td class="text-center p-1.5"><%=list.note%></td>
        </tr>
      <%}); %>
  </tbody>
</table>
<div class="ml-[20%] relative inline-block min-w-20 md:ml-[30%]">
    <button onclick="this.nextElementSibling.classList.toggle('hidden')" class=" w-full mt-10 bg-transparent hover:bg-green-500 text-green-700 font-semibold hover:text-white py-2 px-4 border border-green-500 hover:border-transparent rounded">Xem điểm kiểm tra</button>
    <div class="absolute right-0 hidden bg-gray-100">
    <% results3.forEach((element) => { %>
        <a href="/scores/<%= element.session_id %>/<%= element.title %>" 
           class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-300 hover:text-green-600 transition">
            <%= element.title %>
        </a>
    <% }) %>
</div>
</div>


<button onclick="window.location.href='/scores/<%=List[0].session_id%>/create'" class="ml-[20%] mt-10 bg-transparent hover:bg-green-500 text-green-700 font-semibold hover:text-white py-2 px-4 border border-green-500 hover:border-transparent rounded">Thêm điểm kiểm tra</button>

