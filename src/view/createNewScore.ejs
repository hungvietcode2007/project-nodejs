<h1 class=" mb-5 text-3xl font-bold text-center mt-20">Thêm một bài kiểm tra ngày <%=date[0].session_date%> </h1>
<form action="/scores/<%=session_id%>/create" method="post">
<div class="mb-2 text-center text-xl">
    <label for="note" class="font-semibold">Tên bài KT:</label>
    <input required class="border-b border-black focus:border-b-2" type="text" name="title" placeholder="Điền tên bài kiểm tra">
</div>
<p class="mb-2 text-center text-red-500">Chú ý: Cùng 1 buổi học k để tên các bài kiểm tra giống nhau</p>
<input class=" hidden border-b border-black focus:border-b-2" type="text" name="session_id" value="<%=session_id%>">
<input type="text" value="<%=date[0].session_date%>" name="test_date" class="hidden">
    <table class="table-auto w-full max-w-7xl mx-auto">
      <thead class="bg-gray-400">
        <tr class="">
          <th>STT</th>
          <th class="p-2">Mã học viên</th>
          <th>Họ tên</th>
          <th>Ngày sinh</th>
          <th>Điểm</th>
          <th>Ghi chú</th>
        </tr>
      </thead>
      <tbody>
      <% List.forEach((list,index) => {%>
            <tr class="hover:bg-gray-200">
              <td class="text-center p-1.5"><%=index+1%></td>
              <td class="text-center p-1.5"><%=list.code%>
            <input type="text" name="student_id" class="hidden" value="<%=list.id%>"></td>
              <td class="text-center p-1.5"><%=list.full_name%></td>
              <td class="text-center p-1.5"><%=list.date_of_birth%></td>
              <td class="text-center p-1.5">
                <input type="text" name="score" class="w-10 border border-gray-700">
                </td>
              <td class="text-center p-1.5"><input class="border-b border-black" type="text" name="note"></td>
            </tr>
          <%}); %>
      </tbody>
    </table>
    <button type="submit" class="ml-[40%] mt-10 bg-transparent hover:bg-green-500 text-green-700 font-semibold hover:text-white py-2 px-4 border border-green-500 hover:border-transparent rounded">Thêm</button>
</form>