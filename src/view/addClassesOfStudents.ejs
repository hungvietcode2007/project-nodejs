<h1 class="mt-20 mb-5 text-3xl font-bold text-center">Các lớp có thể thêm</h1>
<form action="/students/<%=student_id%>/add" method="post">
    <table class="table-auto w-full max-w-7xl mx-auto">
      <thead class="bg-gray-400">
        <tr class="">
          <th>STT</th>
          <th class="p-2">Chọn</th>
          <th>Mã lớp</th>
          <th>Tên</th>
          <th>Môn học</th>
          <th>Giáo viên</th>
          <th>Mô tả</th>
        </tr>
      </thead>
      <tbody>
      <% classesList.forEach((classes,index) => {%>
            <tr onclick="const checkbox=this.querySelector('input[type=checkbox]');
            if (event.target !== checkbox) checkbox.checked = !checkbox.checked;
            this.classList.toggle('bg-green-200',checkbox.checked)"
             class="cursor-pointer">
              <td class="text-center p-1.5"><%=index+1%></td>
              <td class="text-center p-1.5"><input type="checkbox" name="classID" value="<%= classes.id %>"></td>
              <td class="text-center p-1.5"><%=classes.code%></td>
              <td class="text-center p-1.5"><%=classes.name%></td>
              <td class="text-center p-1.5"><%=classes.subject%></td>
              <td class="text-center p-1.5"><%=classes.teacher_name%></td>
              <td class="text-center p-1.5"><%=classes.description%></td>
            </tr>
          <%}); %>
      </tbody>
    </table>
    <button type="submit" class="ml-10 mt-10 bg-transparent hover:bg-green-500 text-green-700 font-semibold hover:text-white py-2 px-4 border border-green-500 hover:border-transparent rounded">Thêm</button>
</form>