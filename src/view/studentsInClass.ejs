<h1 class=" mb-5 text-3xl font-bold text-center mt-20">Danh sách học viên của lớp <%=JSON.stringify(class_name[0].name) %></h1>
<table class="table-auto w-full max-w-7xl mx-auto">
  <thead class="bg-gray-400">
    <tr class="">
      <th>STT</th>
      <th class="p-2">Mã học viên</th>
      <th>Họ tên</th>
      <th>Ngày sinh</th>
      <th>Giới tính</th>
      <th>Email</th>
      <th>SĐT</th>
      <th>Ghi chú</th>
      <th>Hành động</th>
    </tr>
  </thead>
  <tbody>
  <% studentsList.forEach((students,index) => {%>
        <tr onclick="window.location.href='/students/<%=students.id%>'"
        class="hover:bg-gray-200 hover:cursor-pointer">
          <td class="text-center p-1.5"><%=index+1%></td>
          <td class="text-center p-1.5"><%=students.code%></td>
          <td class="text-center p-1.5"><%=students.full_name%></td>
          <td class="text-center p-1.5"><%=students.date_of_birth%></td>
          <td class="text-center p-1.5"><%=students.gender%></td>
          <td class="text-center p-1.5"><%=students.email%></td>
          <td class="text-center p-1.5"><%=students.phone%></td>
          <td class="text-center p-1.5"><%=students.note%></td>
          <td class="text-center">
          <button class="bg-transparent hover:bg-white font-semibold px-3 border rounded" 
          onclick="event.stopPropagation();window.location.href='/students/<%=students.id%>/edit'">Sửa  </button>
            <button onclick="event.stopPropagation()"
            data-student-id="<%=students.id%>"
            data-class-id="<%=class_id%>"
            data-student-name="<%=students.full_name%>"
        class="btn-delete bg-transparent hover:bg-red-500 hover:text-white font-semibold px-3 border rounded">Xóa</button>
          </td>
        </tr>
      <%}); %>
  </tbody>
</table>

<button class="confirm ml-[45%] mt-10 bg-transparent hover:bg-green-500 text-green-700 font-semibold hover:text-white py-2 px-4 border border-green-500 hover:border-transparent rounded"
onclick="window.location.href='/classes/<%=class_id%>/add'">Thêm học viên vào lớp</button>
<div id="delete-modal" tabindex="-1" class="hidden bg-gray-900/50 overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
        <div class="relative p-4 w-full max-w-md max-h-full">
                <div class="p-4 md:p-5 text-center bg-white">
                    <svg class="mx-auto mb-4 text-fg-disabled w-12 h-12" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13V8m0 8h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                    <h3 id="question" class="mb-6 text-body"></h3>
                    <div class="flex items-center space-x-4 justify-center">
                        <form id="delete-form" method="post" action="">
                            <button data-modal-hide="popup-modal" class="text-body bg-neutral-secondary-medium box-border border border-default-medium hover:bg-neutral-tertiary-medium hover:text-heading focus:ring-4 focus:ring-neutral-tertiary shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none hover:bg-red-500 hover:text-white">
                            Xóa
                            </button>
                        </form>
                        <button id="btn-cancel" data-modal-hide="popup-modal" type="button" class="text-body bg-neutral-secondary-medium box-border border border-default-medium hover:bg-neutral-tertiary-medium hover:text-heading focus:ring-4 focus:ring-neutral-tertiary shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none hover:bg-gray-500 hover:text-white">Không</button>
                </div>
            </div>
        </div>
    </div>
