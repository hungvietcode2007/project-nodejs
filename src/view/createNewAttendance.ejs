<h1 class=" mb-5 text-3xl font-bold text-center mt-20">Tạo mới điểm danh ngày <%=date%> </h1>
<form action="/classes/<%=class_id%>/attendance/create" method="post">
<div class="mb-5 text-center">
    <label for="note" class="font-semibold">Ghi chú:</label>
    <input class="border-b border-black focus:border-b-2" type="text" id="note" name="session_note" placeholder="Ghi chú về buổi học">
</div>
<input type="text" value="<%=date%>" name="session_date" class="hidden">
<input type="text" name="class_id" class="hidden" value="<%=class_id%>">
    <table class="table-auto w-full max-w-7xl mx-auto">
      <thead class="bg-gray-400">
        <tr class="">
          <th>STT</th>
          <th class="p-2">Mã học viên</th>
          <th>Họ tên</th>
          <th>Ngày sinh</th>
          <th>Trạng thái</th>
          <th>Ghi chú</th>
        </tr>
      </thead>
      <tbody>
      <% List.forEach((list,index) => {%>
            <tr class="hover:bg-gray-200">
              <td class="text-center p-1.5"><%=index+1%></td>
              <td class="text-center p-1.5"><%=list.code%>
            <input type="text" name="student_id" class="hidden" value="<%=list.id%>"></td>
              <td class="text-center p-1.5"><%=list.full_name%>
              <td class="text-center p-1.5"><%=list.date_of_birth%></td>
              <td class="text-center p-1.5">
            <select 
            name="status" 
            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
                <option value="Đi học" selected>Đi học</option>
                <option value="Nghỉ">Nghỉ</option>
            </select>
                </td>
              <td class="text-center p-1.5"><input class="border-b border-black" type="text" name="student_note"></td>
            </tr>
          <%}); %>
      </tbody>
    </table>
    <button type="submit" class="ml-[40%] mt-10 bg-transparent hover:bg-green-500 text-green-700 font-semibold hover:text-white py-2 px-4 border border-green-500 hover:border-transparent rounded">Thêm</button>
</form>